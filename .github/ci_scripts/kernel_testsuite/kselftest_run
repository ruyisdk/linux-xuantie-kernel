#!/bin/bash
# SPDX-License-Identifier: MIT

print_help() {
    echo "Usage: $0 [test_group]"
    echo "test_group can be one of: { SCHED | MM | FS | HOTPLUG | SYSCALL | PERF | FTRACE | CGROUP | PID | KVM | RISCV | LIVEPATCH }"
    echo "ERROR! Missing Args !ERROR"
    exit 1
}

if uname -r | grep -q yocto; then
  KSELFTEST_BASE=/usr/kernel-selftest
else
  KSELFTEST_BASE=/usr/lib/kselftests
fi

#export kselftest_default_timeout=4500

case $1 in
  SCHED)
    GROUP=sched
    TESTLIST="sched:cs_prctl_test"
    SKIPLIST="sched:cs_prctl_test"
    ;;
  MM)
    GROUP=mm
    TESTLIST="mm:soft-dirty mm:run_vmtests.sh"
    SKIPLIST="mm:run_vmtests.sh"
    ;;
  FS)
    GROUP=filesystems
    TESTLIST="filesystems:devpts_pts filesystems/epoll:epoll_wakeup_test"
    SKIPCASE="global.epoll60 global.epoll59"
    ;;
  HOTPLUG)
    GROUP=hotplug
    TESTLIST="cpu-hotplug:cpu-on-off-test.sh memory-hotplug:mem-on-off-test.sh"
    SKIPLIST="memory-hotplug:mem-on-off-test.sh"
    ;;
  SYSCALL)
    GROUP=syscall_user_dispatch
    TESTLIST="syscall_user_dispatch:sud_test syscall_user_dispatch:sud_benchmark"
    ;;
  PERF)
    GROUP=perf_events
    TESTLIST="perf_events:sigtrap_threads perf_events:remove_on_exec"
    SKIPLIST="perf_events:sigtrap_threads perf_events:remove_on_exec"
    ;;
  FTRACE)
    GROUP=ftrace
    rm -rf $KSELFTEST_BASE/ftrace/test.d/kprobe
    # Increase SLEEP_TIME for timing-sensitive tests to avoid flaky failures in QEMU/CI
    sed -i 's/SLEEP_TIME=".1"/SLEEP_TIME=".5"/' \
      $KSELFTEST_BASE/ftrace/test.d/ftrace/func_event_triggers.tc \
      $KSELFTEST_BASE/ftrace/test.d/ftrace/func_traceonoff_triggers.tc
    TESTLIST="ftrace:ftracetest-ktap"
    SKIPCASE="UNRESOLVED UNRESOLVED 14 21 38 43 48 49 50 52 54 56 57 58 59 62 65 66 67 68 69 70 71 97 122"
    ;;
  CGROUP)
    GROUP=cgroup
    TESTLIST="cgroup:test_memcontrol cgroup:test_kmem cgroup:test_core cgroup:test_freezer cgroup:test_kill cgroup:test_cpu cgroup:test_cpuset cgroup:test_zswap cgroup:test_stress.sh cgroup:test_cpuset_prs.sh"
    SKIPLIST="cgroup:test_cpu cgroup:test_cpuset_prs.sh cgroup:test_zswap"
    SKIPCASE="test_memcg_sock test_cgfreezer_ptrace test_kmem_dead_cgroups test_memcg_reclaim test_memcg_min test_memcg_low"
    ;;
  PID)
    GROUP=pid_namespace
    TESTLIST="pid_namespace:regression_enomem"
    ;;
  RESCTRL)
    GROUP=resctrl
    TESTLIST="resctrl:resctrl_tests"
    ;;
  RISCV)
    GROUP=riscv
    TESTLIST="riscv:hwprobe riscv:cbo riscv:string_zbb_bench riscv:dtso riscv:vstate_prctl riscv:v_initval_nolibc riscv:run_mmap.sh riscv:pointer_masking riscv:run_cfi.sh"
    ;;
  LIVEPATCH)
    GROUP=livepatch
    TESTLIST="livepatch:test-livepatch.sh livepatch:test-callbacks.sh livepatch:test-shadow-vars.sh livepatch:test-state.sh livepatch:test-ftrace.sh livepatch:test-sysfs.sh"
    ;;
  KVM)
    GROUP=kvm
    if zcat /proc/config.gz | grep -q "CONFIG_KVM=m";then
       apt install -y kernel-module-kvm* && modprobe kvm
    fi
    echo "timeout=4500" | tee "$KSELFTEST_BASE/kvm/settings"
    TESTLIST="kvm:get-reg-list kvm:demand_paging_test kvm:dirty_log_test kvm:guest_print_test kvm:kvm_binary_stats_test kvm:kvm_create_max_vcpus kvm:kvm_page_table_test kvm:set_memory_region_test kvm:steal_time"
    ;;
  IOMMU)
    GROUP=iommu
    if zcat /proc/config.gz | grep -q "CONFIG_IOMMUFD=m";then
      modprobe iommufd
    fi
    TESTLIST="iommu:iommufd iommu:iommufd_fail_nth"
    ;;
  *)
    print_help
    ;;
esac

echo "==== StartTime: $(date) ===="

if [ -d "$KSELFTEST_BASE" ]; then
    RESULT_DIR="$PWD/KSELFTEST-result"
    mkdir -p "$RESULT_DIR"
    rm -rf "$RESULT_DIR/*_$GROUP.log"
    echo "==== Start KSELFTEST test"

    # 将字符串转换为数组
    read -r -a test_array <<< "$TESTLIST"
    read -r -a skip_array <<< "$SKIPLIST"
    if [ -n "$SKIPCASE" ]; then
        read -r -a skip_case <<< "$SKIPCASE"
    fi

    # 创建一个新数组，用于存放过滤后的测试项
    filtered_tests=()

    # 遍历 TESTLIST 中的每个测试项
    for test in "${test_array[@]}"; do
        skip=false
        # 检查该测试项是否在 SKIPLIST 中
        for skip_test in "${skip_array[@]}"; do
            if [ "$test" == "$skip_test" ]; then
                skip=true
                break
            fi
        done
        # 如果没有被跳过，添加到 filtered_tests
        if [ "$skip" == false ]; then
            filtered_tests+=("$test")
        fi
    done

    # 将数组转换回空格分隔的字符串
    RUNLIST="${filtered_tests[*]}"

    # 确保 RUNLIST 不为空
    if [ -z "$RUNLIST" ]; then
        # echo "SKIP! No tests available after skipping!"; exit 1
        echo "KSELFTEST TEST ${GROUP} PASSED";exit 0
    fi

    echo "==== Test List $RUNLIST in Group $GROUP"

    if [ "$GROUP" == "cgroup" ]; then
      if [[ -n "$LAVA_STATIC_INFO_0_pc_ip" ]] && uname -r | grep -q yocto; then
        echo "Test in nbd rootfs"
      fi
        mount -t cgroup2 none /sys/fs/cgroup -o nsdelegate
        mkdir -p /sys/fs/cgroup/freezer
        mount -t cgroup -o freezer none /sys/fs/cgroup/freezer
        mount -t debugfs none /sys/kernel/debug
        # fallocate -l 1G /swapfile
        # chmod 600 /swapfile
        # mkswap /swapfile
        # swapon /swapfile
        # swapon --show
        ln -s /bin/true /usr/bin/true
    fi

    $KSELFTEST_BASE/run_kselftest.sh -o 4500 -t "$RUNLIST" >> "$RESULT_DIR/result_$GROUP.log" 2>&1
    cat "$RESULT_DIR/result_$GROUP.log"

    # 首层检查，是否有not ok，如有第二层检查，# not ok是否满足跳过条件
    if grep -q "^not ok" "$RESULT_DIR/result_$GROUP.log"; then
        grep "^not ok" "$RESULT_DIR/result_$GROUP.log"
        error=0
        if grep -q "^# not ok" "$RESULT_DIR/result_$GROUP.log"; then
            while IFS= read -r line; do
                if grep -q "^# not ok" <<< "$line"; then
                    skip_error=1
                    # 原有 SKIPCASE 检查
                    for exclude in "${skip_case[@]}"; do
                        if [[ "$line" == *"$exclude"* ]]; then
                            skip_error=0
                            break
                        fi
                    done

                    # 新增：FS 组自动跳过 epoll Expected == 错误（即使不在 SKIPCASE 中）
                    if [ "$skip_error" -eq 1 ] && [ "$GROUP" == "filesystems" ]; then
                        if [[ "$line" =~ not\ ok\ [0-9]+\ ([^[:space:]]+)$ ]]; then
                            test_name="${BASH_REMATCH[1]}"
                            # 检查该测试名附近是否有 epoll_wakeup_test.c 的 Expected == 错误
                            if grep -A3 -B3 -- "$test_name" "$RESULT_DIR/result_$GROUP.log" | \
                               grep -q "epoll_wakeup_test\.c:.*Expected .* == "; then
                                skip_error=0
                                echo "INFO: Auto-skipping benign epoll 'Expected == ' mismatch for $test_name"
                            fi
                        fi
                    fi

                    if [ "$skip_error" -eq 0 ]; then
                        continue  # 跳过该行
                    else
                        error=1
                        echo "ERROR! KSELFTEST TEST ${GROUP} contains failure: $line"
                        break
                    fi
                fi
            done < "$RESULT_DIR/result_$GROUP.log"

            if [ "$error" -eq 0 ]; then
                echo "KSELFTEST TEST ${GROUP} PASSED"
            fi
        else
            echo "ERROR! KSELFTEST TEST ${GROUP} contains failure"
        fi
    else
        echo "KSELFTEST TEST ${GROUP} PASSED"
    fi
else
    echo "ERROR! kselftests does NOT exist!!! !ERROR!"; exit 1
fi

echo "==== EndTime: $(date) ===="
